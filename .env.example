# Plantilla del entorno local Docker (ADR 0014).
# Copiar a `.env` (gitignored) y rellenar; nunca commitear el `.env` real.
#   cp .env.example .env
# Generar contraseñas: openssl rand -hex 16
MARIADB_DATABASE=wordpress
MARIADB_USER=wordpress
MARIADB_PASSWORD=cambiar-por-password-aleatorio
MARIADB_ROOT_PASSWORD=cambiar-por-password-aleatorio
WORDPRESS_PORT=8080
